@inproceedings{choi2026auditing,
  abbr        = {CIKM},
  bibtex_show = {true},
  title       = {Auditing Ethical Value Misalignment in LLM-Based Human Simulation: A Dual-Metric Cross-National Study with Persona Injection},
  author      = {Choi, Yena and Han, Kyungsik},
  booktitle   = {Proceedings of the 35th ACM International Conference on Information and Knowledge Management (CIKM '26)},
  year        = {2026},
  month       = {November},
  address     = {Rome, Italy},
  publisher   = {ACM},
  numpages    = {5},
  doi         = {10.1145/3799682.3840045},
  url         = {https://doi.org/10.1145/3799682.3840045},
  html        = {https://doi.org/10.1145/3799682.3840045},
  pdf         = {choi2026auditing.pdf},
  code        = {https://github.com/mirage-cikm/MIRAGE_Statistical_Full_Results},
  abstract    = {In this paper, we propose MIRAGE (Misalignment and Representation Audit for Global Ethical Simulation), a cross-national, multi-LLM framework that empirically audits how faithfully persona-injected LLMs represent human ethical values along two axes: directional bias -- a systematic skew of LLM responses toward a particular ethical direction -- and distributional diversity -- how well LLM responses preserve the spread of human responses. Our method (1) constructs a seven-category taxonomy from the 23 items in the World Values Survey (WVS) Wave 7 Ethical Values and Norms section, (2) generates 10,000 stratified personas per country across eight countries from WVS demographic distributions and injects them into LLMs, and (3) measures ethical value misalignment between LLM and human responses. Category-level paired tests (7 categories x 3 LLMs = 21 comparisons) reveal significant human-LLM differences in 18 of 21 for distributional diversity and 12 of 21 for directional bias, with the item-level tests (23 items x 3 LLMs = 69 comparisons) confirming that this misalignment is pervasive (44/69). LLMs show lower distributional diversity than humans across nearly all categories, indicating that they fail to represent response diversity, and LLMs show lower permissiveness in Dishonesty & Corruption, while directional bias in Political Violence varies by model. These findings demonstrate that researchers should jointly audit LLM-based personas for directional bias and distributional diversity before using them as proxies for human populations.},
  selected    = {true}
}

@inproceedings{choi2026topic,
  abbr        = {HCIK},
  bibtex_show = {true},
  title       = {Topic-Specific Bias and Inter-Model Differences in Large Language Models},
  author      = {Choi, Yena and Han, Kyungsik},
  booktitle   = {Proceedings of HCI Korea 2026 (HCIK 2026)},
  year        = {2026},
  pdf         = {choi2026topic.pdf},
  abstract    = {Large language models (LLMs) are increasingly used to substitute for human participants in surveys, offering a faster and cheaper alternative to traditional questionnaires. However, it remains unclear how faithfully LLMs can represent human opinions, and prior work has not systematically quantified bias by topic and by model. This study compares the opinion distributions of two representative LLMs, GPT-4o-mini and Gemini-2.5-flash, against real survey results on four socially controversial topics: euthanasia, gender, animal testing, and abortion. Using a Multi-Expert Prompting framework with 50 expert agents per model, we generate LLM response distributions and compare them to human survey distributions with two-proportion z-tests. Results show that GPT-4o-mini is significantly more favorable than survey results on euthanasia and gender compared to Gemini-2.5-flash, while Gemini-2.5-flash is somewhat more favorable than GPT-4o-mini on animal testing. These topic- and model-specific biases suggest that using LLMs and LLM families to represent or substitute for human opinion requires deliberately balancing responses across diverse LLMs.},
  selected    = {true}
}

@inproceedings{kim2026safety,
  abbr        = {HCIK},
  bibtex_show = {true},
  title       = {An LLM-Based Safety Evaluation Framework for Autonomous Driving Plans},
  author      = {Kim, Myungjin and Choi, Yena and Han, Kyungsik},
  booktitle   = {Proceedings of HCI Korea 2026 (HCIK 2026)},
  year        = {2026},
  pdf         = {kim2026safety.pdf},
  abstract    = {As autonomous driving technology advances, ensuring safety in unpredictable, real-world road environments has become an increasingly important challenge. This paper proposes a safety evaluation framework that quantitatively and qualitatively assesses whether LLM-generated autonomous driving plans are safe, particularly in exceptional situations. The framework consists of a Safety Taxonomy defining four safety and ethics criteria, a Verifier that evaluates driving plans against the taxonomy using three LLMs (GPT, Llama, and Gemini), and a Scorer that aggregates the models' quantitative and qualitative assessments. We validate the framework's effectiveness on eight autonomous-driving scenarios grounded in real accident cases. Results confirm that the framework effectively identifies dangerous driving plans, appropriately withholds judgment when information is insufficient, and supports concrete directions for improving driving plans based on its quantitative and qualitative outputs.},
  selected    = {false}
}
